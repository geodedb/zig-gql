.{
    .name = .gql,
    .version = "0.1.23",
    .fingerprint = 0xc0f961730d0d504f,
    .minimum_zig_version = "0.15.1",
    .dependencies = .{
        .thread_pool = .{
            .url = "git+https://gitlab.com/devnw/zig/thread-pool.git?ref=v0.2.11#666b7ac0cc8b92d5773df5e79ea4fd421bd77e99",
            .hash = "thread_pool-0.2.11-11B1Bk2GegC5mn18xNrkmF0lMrgrWqijO7PXmftrkuSe",
        },
        // Otel observability dep. Lazy: only fetched when the build
        // reaches `b.lazyDependency("otel", ...)` under `-Dwith_otel=true`.
        // With the flag off the dependency is never resolved and the
        // produced artifact contains zero otel symbols (verified by
        // otel/scripts/verify-consumer-noop.sh).
        .otel = .{
            .url = "git+https://gitlab.com/devnw/zig/otel.git?ref=v0.1.30#dbf58bae612ef3f5f78c62c130b4c6d63f5aa297",
            .hash = "otel-0.1.30-B0v3lrGuNQDL0D3_KAb6qK6MaYmz2QeutCp0Sg3SL1H7",
            .lazy = true,
        },
        // Grammar verification dep (ISO/IEC 39075 BNF parser + validator).
        // Lazy: `b.lazyDependency("ebnf", ...)` is gated behind
        // `-Dgrammar=true` in build.zig, so it is only fetched when that
        // flag is passed (e.g. `zig build test-grammar -Dgrammar=true`).
        // Without the flag the dependency is never reached, regardless of
        // which step is being built.
        .ebnf = .{
            .url = "git+https://gitlab.com/devnw/zig/ebnf.git?ref=v0.2.6#78b4bbe54e1b67fd850eddefa4a254f0aae342ef",
            .hash = "ebnf-0.2.6-rCUW9PSdAwAF0D45v9ufQVdOlUJZj1TWXbI62jF4Kv4u",
            .lazy = true,
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "LICENSE",
        "README.md",
        "benchmarks",
        "examples",
        "tests",
        "grammar",
    },
}
