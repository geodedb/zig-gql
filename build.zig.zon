.{
    .name = .gql,
    .version = "0.1.12",
    .fingerprint = 0xc0f961730d0d504f,
    .minimum_zig_version = "0.15.1",
    .dependencies = .{
        .thread_pool = .{
            .url = "git+https://gitlab.com/devnw/zig/thread-pool.git?ref=v0.2.7#54a2ddda1a356c32ba2e4df70691459570fb6339",
            .hash = "thread_pool-0.2.7-11B1BvRneQBnMkDnRbKd76THvZn4ZhDhmlWQw-aziWQm",
        },
        // Otel observability dep. Lazy: only fetched when the build
        // reaches `b.lazyDependency("otel", ...)` under `-Dwith_otel=true`.
        // With the flag off the dependency is never resolved and the
        // produced artifact contains zero otel symbols (verified by
        // otel/scripts/verify-consumer-noop.sh).
        .otel = .{
            .url = "git+https://gitlab.com/devnw/zig/otel.git#v0.1.17",
            .hash = "otel-0.1.17-B0v3lvT2NQAYURxdLxS-8cMcAqL8Qfniddlwq1ai86G7",
            .lazy = true,
        },
        // Grammar verification dep (ISO/IEC 39075 BNF parser + validator).
        // Lazy: `b.lazyDependency("ebnf", ...)` is gated behind
        // `-Dgrammar=true` in build.zig, so it is only fetched when that
        // flag is passed (e.g. `zig build test-grammar -Dgrammar=true`).
        // Without the flag the dependency is never reached, regardless of
        // which step is being built.
        .ebnf = .{
            .url = "git+https://gitlab.com/devnw/zig/ebnf.git?ref=v0.2.1",
            .hash = "ebnf-0.2.1-rCUW9PB7AwBS6QjNDMRWrRHUUTkP26sAMN4MK59i3jw5",
            .lazy = true,
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "LICENSE",
        "README.md",
    },
}
