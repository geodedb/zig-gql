.{
    .name = .gql,
    .version = "0.1.0",
    .fingerprint = 0xc0f961730d0d504f,
    .minimum_zig_version = "0.15.1",
    .dependencies = .{
        .thread_pool = .{
            .url = "git+https://gitlab.com/devnw/zig/thread-pool.git#930d41bcd52b0f92f5405da69a72949a970a2990",
            .hash = "thread_pool-0.2.1-11B1BobIdgAJ7WWVFfqS0BxtbO_vXdSevdXwauTZhSuS",
        },
        // Otel observability dep. Lazy: only fetched when the build
        // reaches `b.lazyDependency("otel", ...)` under `-Dwith_otel=true`.
        // With the flag off the dependency is never resolved and the
        // produced artifact contains zero otel symbols (verified by
        // otel/scripts/verify-consumer-noop.sh).
        .otel = .{
            .url = "git+https://gitlab.com/devnw/zig/otel.git#2665f64d4fb85f8d7beb6b21f2218317ea2fc05e",
            .hash = "otel-0.1.0-B0v3lrgNNADQwluWDPhv5kY_7L_C1vptqunNkx_Ipzy1",
            .lazy = true,
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "LICENSE",
        "README.md",
    },
}
