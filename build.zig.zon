.{
    .name = .gql,
    .version = "0.1.0",
    .fingerprint = 0xc0f961730d0d504f,
    .minimum_zig_version = "0.15.1",
    .dependencies = .{
        .thread_pool = .{
            .url = "git+https://gitlab.com/devnw/zig/thread-pool.git#c41388bdab88916bb453a20adae2c722405287d1",
            .hash = "thread_pool-0.2.1-11B1BsqSdgCqx_EsSPzdPqfGhNFzonijUGYfDuy0fpTb",
        },
        // Otel observability dep. Lazy: only fetched when the build
        // reaches `b.lazyDependency("otel", ...)` under `-Dwith_otel=true`.
        // With the flag off the dependency is never resolved and the
        // produced artifact contains zero otel symbols (verified by
        // otel/scripts/verify-consumer-noop.sh).
        .otel = .{
            .url = "git+https://gitlab.com/devnw/zig/otel.git#efe116b388d43472eaab5b6c24a13725156df417",
            .hash = "otel-0.1.0-B0v3lrgNNAAbt_xZDbOsBAS1bFFkspiibIElaWuVMK4M",
            .lazy = true,
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "LICENSE",
        "README.md",
    },
}
